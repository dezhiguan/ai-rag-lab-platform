# Nginx 反向代理配置示例
# 适用场景：单台 ECS 部署前端静态资源 + 后端 API 反代
#
# 使用前请替换：
#   - your_domain.com → 实际域名
#   - /var/www/rag-lab/frontend → 前端 dist 部署目录
#   - 127.0.0.1:8080 → 后端实际监听地址
#
# 安装参考（Ubuntu / Debian）：
#   sudo apt install nginx
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/rag-lab
#   sudo ln -s /etc/nginx/sites-available/rag-lab /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream rag_lab_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name your_domain.com;

    # HTTPS 升级后可将 HTTP 301 到 HTTPS（见下方 HTTPS server 块）
    # return 301 https://$host$request_uri;

    root /var/www/rag-lab/frontend;
    index index.html;

    client_max_body_size 25m;

    # 前端静态资源（Vue Router history 模式）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反代
    location /api/ {
        proxy_pass http://rag_lab_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # 可选：Knife4j / Swagger（生产默认关闭，仅在 SPRINGDOC_ENABLED=true 时启用）
    # location /doc.html {
    #     proxy_pass http://rag_lab_backend;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    access_log /var/log/nginx/rag-lab.access.log;
    error_log /var/log/nginx/rag-lab.error.log;
}

# HTTPS 配置说明（预留，需有效证书）
