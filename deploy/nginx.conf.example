# Nginx 配置示例 · 应用入口层（轻量服务器 2C4G）
#
# 双服务器架构：
#   - 本机托管前端 dist，对外 80 / 443
#   - /api 反代到本机 Java 后端 127.0.0.1:8080
#   - PostgreSQL / Elasticsearch / Redis 在 ECS 内网，禁止经 Nginx 暴露
#
# 替换占位符：
#   your_domain.com → 备案后域名；临时可用 server_name _; 配合公网 IP 访问
#   /var/www/rag-lab/frontend → 前端 dist 目录
#
# 安装（Ubuntu）：
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/rag-lab
#   sudo ln -s /etc/nginx/sites-available/rag-lab /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream rag_lab_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    # 备案前：可用 default_server + 公网 IP 访问，例如 http://<LIGHT_SERVER_PUBLIC_IP>/
    server_name your_domain.com;
    # server_name _;

    root /var/www/rag-lab/frontend;
    index index.html;

    client_max_body_size 25m;

    # 前端静态资源（Vue Router history）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # RAG 后端 API（仅反代本机 Java，不反代 PG/ES/Redis）
    location /api/ {
        proxy_pass http://rag_lab_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # 预留：AI 求职 Agent API（未来独立 upstream / location，勿与 RAG 混用）
    # location /agent-api/ {
    #     proxy_pass http://127.0.0.1:8081;
    #     ...
    # }

    access_log /var/log/nginx/rag-lab.access.log;
    error_log /var/log/nginx/rag-lab.error.log;
}

# HTTPS（备案并申请证书后启用）
