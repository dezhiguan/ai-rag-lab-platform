# 应用入口层环境变量（轻量服务器 2C4G）
# 使用方式：
#   cp deploy/app-layer/.env.app.example deploy/app-layer/.env.app
#   编辑 deploy/app-layer/.env.app（勿提交 Git）
#   scripts/deploy-backend-app.sh 会加载此文件

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 数据检索层（ECS 内网，勿使用公网 IP）
POSTGRES_HOST=<ECS_PRIVATE_IP>
POSTGRES_PORT=5432
POSTGRES_DB=rag_lab
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_strong_password

ES_HOSTS=http://<ECS_PRIVATE_IP>:9200
ES_USERNAME=elastic
ES_PASSWORD=change_me_es_password

REDIS_HOST=<ECS_PRIVATE_IP>
REDIS_PORT=6379
REDIS_PASSWORD=

# 模型 API Key
DASHSCOPE_API_KEY=your-key
DEEPSEEK_API_KEY=your-key

RAG_EMBEDDING_PROVIDER=qwen
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_CHAT_PROVIDER=deepseek
RAG_CHAT_MODEL=deepseek-chat

# 上传目录（轻量服务器本地）
RAG_STORAGE_PATH=/var/lib/rag-lab/uploads

# V10 访问保护（生产环境请修改为强密码）
AUTH_ADMIN_PASSWORD=change_me_admin_password
AUTH_GUEST_PASSWORD=change_me_guest_password

KNIFE4J_ENABLE=false
SPRINGDOC_ENABLED=false

# 部署脚本可选覆盖
# APP_DEPLOY_DIR=/opt/rag-lab/app
# NGINX_STATIC_DIR=/var/www/rag-lab/frontend
