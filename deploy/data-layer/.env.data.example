# 数据与检索层环境变量（ECS 上 docker compose 使用）
# 使用方式：
#   cd deploy/data-layer
#   cp .env.data.example .env.data
#   编辑 .env.data（勿提交 Git）
#   docker compose -f docker-compose.data.yml --env-file .env.data up -d

# PostgreSQL + PgVector
POSTGRES_DB=rag_lab
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Elasticsearch（4C8G ECS 建议 1g～2g 堆，可按负载调整）
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms1g -Xmx2g

# Redis（RAG 业务尚未接入，仅基础设施预留）
REDIS_PORT=6379
REDIS_PASSWORD=
