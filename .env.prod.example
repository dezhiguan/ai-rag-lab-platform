# 生产环境变量模板（阿里云部署前准备）
# 使用方式：
#   cp .env.prod.example .env.prod
#   编辑 .env.prod 填入真实值（勿提交 Git）
#   启动后端前加载：set -a && source .env.prod && set +a
#   或使用 scripts/run-backend-prod.sh

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# 后端监听端口（仅本机或内网暴露，对外由 Nginx 反代）
SERVER_PORT=8080

# PostgreSQL（示例：阿里云 RDS）
POSTGRES_HOST=your-rds-host.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_DB=rag_lab
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_strong_password

# Elasticsearch（示例：自建 ES 或云服务）
ES_HOSTS=http://your-es-host:9200
ES_USERNAME=elastic
ES_PASSWORD=change_me_es_password

# 模型 API Key（生产建议使用真实 Provider）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# RAG Provider（可选覆盖，默认 qwen + deepseek）
RAG_EMBEDDING_PROVIDER=qwen
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_CHAT_PROVIDER=deepseek
RAG_CHAT_MODEL=deepseek-chat

# 上传文件存储目录（需确保进程有读写权限）
RAG_STORAGE_PATH=/var/lib/rag-lab/uploads

# API 文档（生产默认关闭）
KNIFE4J_ENABLE=false
SPRINGDOC_ENABLED=false
