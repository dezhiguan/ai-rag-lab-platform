# 生产环境变量模板 · 双服务器部署
#
# 架构：
#   应用入口层（轻量 2C4G）— 运行本 jar、Nginx、前端 dist
#   数据检索层（ECS 4C8G）— PostgreSQL、Elasticsearch、Redis（内网）
#
# 使用方式：
#   cp .env.prod.example .env.prod
#   将 <ECS_PRIVATE_IP> 等占位符替换为真实内网地址（勿提交 .env.prod）
#   在轻量服务器：set -a && source .env.prod && set +a
#   或：./scripts/run-backend-prod.sh

SPRING_PROFILES_ACTIVE=prod

# 后端监听（轻量服务器本机，由 Nginx 反代 /api，不对公网暴露 8080）
SERVER_PORT=8080

# PostgreSQL（ECS 内网，勿使用公网 IP）
POSTGRES_HOST=<ECS_PRIVATE_IP>
POSTGRES_PORT=5432
POSTGRES_DB=rag_lab
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_strong_password

# Elasticsearch（ECS 内网）
ES_HOSTS=http://<ECS_PRIVATE_IP>:9200
ES_USERNAME=elastic
ES_PASSWORD=change_me_es_password

# Redis（ECS 内网；当前 RAG 业务未接入，仅部署与 env 预留）
REDIS_HOST=<ECS_PRIVATE_IP>
REDIS_PORT=6379
REDIS_PASSWORD=

# 模型 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

RAG_EMBEDDING_PROVIDER=qwen
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_CHAT_PROVIDER=deepseek
RAG_CHAT_MODEL=deepseek-chat

# 上传目录（轻量服务器本地路径）
RAG_STORAGE_PATH=/var/lib/rag-lab/uploads

# V10 访问保护（生产环境请修改为强密码）
AUTH_ADMIN_PASSWORD=change_me_admin_password
AUTH_GUEST_PASSWORD=change_me_guest_password

KNIFE4J_ENABLE=false
SPRINGDOC_ENABLED=false
