{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "RagApplication",
      "request": "launch",
      "mainClass": "com.guan.rag.RagApplication",
      "projectName": "rag-lab-backend",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frontend: Chrome (需先启动 Vite)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "frontend:dev"
    }
  ]
}
